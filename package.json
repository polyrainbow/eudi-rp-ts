{
  "name": "@sauseschritt/eudi-rp-ts",
  "version": "0.2.0",
  "description": "Reference implementation of an EU Digital Identity relying party for Node — verifies SD-JWT VC and ISO mdoc credentials over OpenID4VP 1.0, with ETSI 119 612 trust lists and status-list revocation. Not affiliated with the European Commission.",
  "main": "./dist/index.js",
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "fixtures": "node scripts/make-fixtures.ts",
    "typecheck": "tsc",
    "probe": "node scripts/probe-reference-issuer.ts",
    "start": "node app/main.ts",
    "access-cert": "node scripts/make-access-cert.ts",
    "register-rp": "node scripts/register-rp.ts",
    "build": "tsc -p tsconfig.build.json",
    "check:package": "node scripts/check-package.ts",
    "prepack": "npm run build",
    "fetch-credential": "node scripts/fetch-reference-credential.ts"
  },
  "keywords": [
    "eudi",
    "eudi-wallet",
    "eidas",
    "sd-jwt-vc",
    "sd-jwt",
    "mdoc",
    "openid4vp",
    "oid4vp",
    "verifiable-credentials",
    "digital-identity",
    "relying-party"
  ],
  "author": "Sebastian Wiese-Wagner",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@openid4vc/openid4vp": "^0.5.4",
    "@peculiar/asn1-schema": "^2.8.0",
    "@peculiar/asn1-x509": "^2.8.0",
    "@sd-jwt/sd-jwt-vc": "^0.20.0",
    "@xmldom/xmldom": "^0.9.10",
    "cbor2": "^2.3.0",
    "jose": "^6.2.8",
    "xml-crypto": "^6.1.2",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@owf/token-status-list": "^0.1.0-alpha-20260422101556",
    "@peculiar/x509": "^2.0.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "README.md",
    "LICENSE",
    "NOTICE",
    "GLOSSARY.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polyrainbow/eudi-rp-ts.git"
  },
  "bugs": {
    "url": "https://github.com/polyrainbow/eudi-rp-ts/issues"
  },
  "homepage": "https://github.com/polyrainbow/eudi-rp-ts#readme",
  "publishConfig": {
    "access": "public"
  }
}
